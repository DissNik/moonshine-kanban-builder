{
    "name": "dissnik/moonshine-kanban-builder",
    "description": "KanBan Builder for MoonShine",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DissNik",
            "homepage": "https://github.com/DissNik",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "DissNik\\MoonShineKanBanBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DissNik\\MoonShineKanBanBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
              "DissNik\\MoonShineKanBanBuilder\\Providers\\MoonShineKanBanBuilderServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1|^8.2|^8.3"
    },
    "require-dev": {
        "illuminate/support": "^11.0|^12.0",
        "moonshine/moonshine": "^4.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
